# Every key can also be set via the upper-case environment variable (e.g. DATABASE_URL).
port: "8080"
database_url: postgresql://postgres:@localhost:5432/hearable?sslmode=disable
jwt_secret: change-me-to-a-random-string-of-at-least-32-chars
openai_api_key: sk-...
# openai_base_url: https://api.openai.com/v1
# openai_eval_model: gpt-4o-mini
# openai_transcribe_model: gpt-4o-mini-transcribe
app_timezone: Asia/Jakarta
cors_origins:
  - http://localhost:3000
  - https://docs.hearable.nighttealabs.tech
